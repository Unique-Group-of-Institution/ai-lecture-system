# Reference names only. Do not commit a populated .env file.
APP_ENV=development
AI_LECTURE_SECRET_KEY=replace-with-a-local-development-value
DATABASE_URL=sqlite:///data/ai_lecture_system.sqlite3
MEDIA_ROOT=data
YOUTUBE_WATCH_FOLDER=data/exports/youtube-watch
LOG_LEVEL=INFO

# UGI CRM shared login. Use the same strong local/dev value as CRM LMS_SSO_SIGNING_SECRET.
# Never reuse AI_LECTURE_SECRET_KEY and never commit a real shared secret.
UGI_CRM_SSO_SIGNING_SECRET=replace-with-a-separate-local-development-value

# Never commit real credentials.
