# Reference names only. Do not commit a populated .env file.
APP_ENV=development
AI_LECTURE_SECRET_KEY=replace-with-a-local-development-value
AI_LECTURE_DEBUG=true
AI_LECTURE_ALLOWED_HOSTS=localhost,127.0.0.1
AI_LECTURE_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=sqlite:///data/ai_lecture_system.sqlite3
AI_LECTURE_DATA_ROOT=data
MEDIA_ROOT=data
YOUTUBE_WATCH_FOLDER=data/exports/youtube-watch
LOG_LEVEL=INFO

# Remote staging example (set these in Railway, not in this file):
# AI_LECTURE_DEBUG=false
# AI_LECTURE_ALLOWED_HOSTS=<your-service>.up.railway.app
# AI_LECTURE_CSRF_TRUSTED_ORIGINS=https://<your-service>.up.railway.app
# DATABASE_URL is supplied by the Railway PostgreSQL service.
# AI_LECTURE_DATA_ROOT=/data   # when a persistent Railway volume is mounted at /data
# AI_LECTURE_SECURE_COOKIES=true

# UGI CRM shared login. Use the same strong value as CRM LMS_SSO_SIGNING_SECRET.
# Never reuse AI_LECTURE_SECRET_KEY and never commit a real shared secret.
UGI_CRM_SSO_SIGNING_SECRET=replace-with-a-separate-local-development-value

# Never commit real credentials.
